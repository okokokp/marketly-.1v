# GEMINI_API_KEY: Required for Gemini AI API calls (if AI features are enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Server-side HMAC secret for signing session tokens (auto-generated fallback in dev).
SESSION_SECRET="CHANGE_ME_IN_PRODUCTION"

# PORT: Server port (must remain 3000 in AI Studio preview).
PORT="3000"
